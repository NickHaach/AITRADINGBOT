FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY packages/shared ./packages/shared
COPY services/learning ./services/learning
COPY services/prediction ./services/prediction

RUN uv pip install --system \
  -e packages/shared \
  -e services/learning \
  -e services/prediction \
  celery redis numpy scikit-learn joblib

ENV PYTHONPATH=/app/packages/shared/src:/app/services/learning/src:/app/services/prediction/src
EXPOSE 8007
CMD ["uvicorn", "learning.api.main:app", "--host", "0.0.0.0", "--port", "8007"]
