FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY packages/shared ./packages/shared
COPY services/news_intelligence ./services/news_intelligence

RUN uv pip install --system -e packages/shared -e "services/news_intelligence"

ENV PYTHONPATH=/app/packages/shared/src:/app/services/news_intelligence/src
EXPOSE 8001
CMD ["uvicorn", "news_intelligence.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
