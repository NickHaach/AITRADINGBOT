FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY packages/shared ./packages/shared
COPY services/market_data ./services/market_data

RUN uv pip install --system -e packages/shared -e services/market_data

ENV PYTHONPATH=/app/packages/shared/src:/app/services/market_data/src
EXPOSE 8002
CMD ["uvicorn", "market_data.api.main:app", "--host", "0.0.0.0", "--port", "8002"]
