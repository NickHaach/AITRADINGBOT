# Application
APP_ENV=development
APP_NAME=ai-trading-platform
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Network
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev_password
DATABASE_URL=postgresql+asyncpg://trading:trading_dev_password@localhost:5432/ai_trading

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NEWS=news_embeddings
QDRANT_API_KEY=

# AI providers (leave empty to use mock/local adapters)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_MOCK_LLM=true

# News adapters (respect provider terms; empty = mock feed)
NEWSAPI_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
USE_MOCK_NEWS=true

# Market data
POLYGON_API_KEY=
USE_MOCK_MARKET_DATA=true

# Execution — paper by default
EXECUTION_MODE=paper
BROKER_ALPACA_API_KEY=
BROKER_ALPACA_SECRET_KEY=
BROKER_ALPACA_BASE_URL=https://paper-api.alpaca.markets
ENABLE_LIVE_TRADING=false

# Risk defaults
RISK_MAX_POSITION_PCT=0.05
RISK_MAX_PORTFOLIO_RISK_PCT=0.20
RISK_DAILY_LOSS_LIMIT_PCT=0.02
RISK_MAX_SECTOR_EXPOSURE_PCT=0.25
RISK_MAX_COUNTRY_EXPOSURE_PCT=0.40
RISK_MAX_DRAWDOWN_PCT=0.15

# Observability
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
